const qs=s=>document.querySelector(s), qsa=s=>[...document.querySelectorAll(s)];
function pills(id,items,key){qs(id).innerHTML=items.map(x=>`<button class="pill ${state[key]===x?"active":""}" data-key="${key}" data-value="${x}">${x}</button>`).join("")}
function renderFilters(){pills("#regionFilters",["All","NA-East","NA-Central","NA-West","EU","Brazil","Oceania","Asia","Middle East"],"region");pills("#modeFilters",["All","Battle Royale","Reload","OG","Creative"],"mode");pills("#teamFilters",["All","Solo","Duo","Trio","Squad"],"team");pills("#buildFilters",["All","Build","Zero Build"],"build");pills("#privacyFilters",["All","Public","Private"],"privacy")}
function renderMatches(){let a=state.matches.filter(m=>(state.region==="All"||m.region===state.region)&&(state.mode==="All"||m.mode===state.mode)&&(state.team==="All"||m.team===state.team)&&(state.build==="All"||m.build===state.build)&&(state.privacy==="All"||m.privacy===state.privacy));qs("#matchCount").textContent=`(${a.length})`;qs("#matches").innerHTML=a.length?a.map(m=>`<div class="match card"><div><div class="matchTop"><span class="matchName">${m.name}</span><span class="tag">${m.mode}</span><span class="tag">${m.build}</span><span class="tag">${m.team}</span></div><div class="meta">🌎 ${m.region} · 👑 Created by ${m.host}</div></div><div><div class="count">👥 ${m.players}/${m.max}</div><span class="tag green">${m.privacy}</span><button class="primary join" data-id="${m.id}">Join Queue</button></div></div>`).join(""):`<div class="card">No live matches match your filters.</div>`;qs("#recent").innerHTML=state.recent.map(r=>`<div class="recentRow"><span>${r[0]} · ${r[1]} · ${r[2]} · ${r[3]}</span><span>${r[4]} · ${r[5]}</span></div>`).join("")}
function show(view){qsa(".view").forEach(x=>x.classList.add("hidden"));qs("#"+view+"View").classList.remove("hidden");qsa("[data-view]").forEach(b=>b.classList.toggle("active",b.dataset.view===view));}
qsa("[data-view]").forEach(b=>b.onclick=()=>show(b.dataset.view==="host"?"host":b.dataset.view));
document.addEventListener("click",e=>{if(e.target.matches(".pill")){state[e.target.dataset.key]=e.target.dataset.value;renderFilters();renderMatches()} if(e.target.matches(".join")){let m=state.matches.find(x=>x.id==e.target.dataset.id);if(m&&m.players<m.max){m.players++;renderMatches();alert(`You joined ${m.name}. Queue: ${m.players}/${m.max}`)}}});
qs("#hostForm").onsubmit=e=>{e.preventDefault();let m={id:Date.now(),name:qs("#hName").value||"Vortex Custom",mode:qs("#hMode").value,team:qs("#hTeam").value,region:qs("#hRegion").value,build:qs("#hBuild").value,players:1,max:+qs("#hMax").value,privacy:qs("#hPrivacy").value,host:"You"};state.matches.unshift(m);renderFilters();renderMatches();show("matches");alert("Match created! In the real version, this would be saved on your server and given a real lobby/key.");};
const chat=[["Alex_PR","¿Alguien para duo?"],["JayR6","Yo 🔥"],["LunaFN","Ya empezó el custom?"],["Vortex","Custom #1043 comienza en 3 min. ❤️"],["ToxicGio","Reload o battle royale?"]];
function renderChat(){qs("#messages").innerHTML=chat.map((m,i)=>`<div class="msg"><b>${m[0]}</b><small>${11+i}:2${i} AM</small><div>${m[1]}</div></div>`).join("");qs("#messages").scrollTop=qs("#messages").scrollHeight}
qs("#chatForm").onsubmit=e=>{e.preventDefault();let v=qs("#chatInput").value.trim();if(!v)return;chat.push(["You",v]);qs("#chatInput").value="";renderChat()};
qs("#signin").onclick=()=>alert("Prototype: connect this button to Discord OAuth in the backend.");
renderFilters();renderMatches();renderChat();

